{
  "name": "skinnyvideo",
  "productName": "SkinnyVideo",
  "version": "2.11.0",
  "description": "Video archive compressor for macOS",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64",
    "postinstall": "node scripts/fix-electron.js"
  },
  "author": "SkinnyVideo",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pritammalakar.skinnyvideo",
    "productName": "SkinnyVideo",
    "asar": true,
    "afterPack": "scripts/sign-ffmpeg.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["ffmpeg", "ffprobe"]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/skinnyvideo.icns",
      "target": [
        { "target": "dir", "arch": ["arm64"] }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    }
  }
}
